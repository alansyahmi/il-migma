{
  "name": "il-migma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:tag-label": "node --experimental-strip-types scripts/tagLabel.test.mjs",
    "test:dual-form": "node --experimental-strip-types scripts/dualForm.test.mjs",
    "test:elative-form": "node --experimental-strip-types scripts/elativeForm.test.mjs",
    "test:stem-forms": "node --experimental-strip-types scripts/stemForms.test.mjs",
    "test:etymology-contract": "node --experimental-strip-types scripts/etymologyContract.test.mjs",
    "import:dry": "node scripts/import-xls.mjs --dry-run",
    "import:all": "node scripts/import-xls.mjs --execute",
    "import:roots": "node scripts/import-xls.mjs --execute --roots-only",
    "import:nouns": "node scripts/import-xls.mjs --execute --nouns-only",
    "validate:api": "node scripts/validate_api.mjs",
    "seed:test-pack": "node scripts/seed-test-pack.mjs",
    "dev:api": "wrangler pages dev --port 8788 --no-show-interactive-dev-session",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:pages": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.30.0",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.488.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.5.3",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wrangler": "^4.69.0",
    "xlsx": "^0.18.5"
  }
}
