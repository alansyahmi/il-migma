                      "source_id": "src-brincat-2011",
                      "citation": "Brincat, J. M. (2011). Maltese and Other Languages: A Linguistic History of Malta, pp. 112–115.",
                      "title": "Maltese and Other Languages: A Linguistic History of Malta",
                      "author": "Joseph M. Brincat",
                      "year": 2011,
                      "page": "112–115",
                      "publisher": "Midsea Books",
                      "role": "analytic genitive evolution in Siculo-Arabic & Maghrebi Arabic"
                },
                {
                      "source_id": "src-borg-1997",
                      "citation": "Borg, A. & Azzopardi-Alexander, M. (1997). Maltese, pp. 110–114.",
                      "title": "Maltese (Routledge Descriptive Grammars)",
                      "author": "Alexander Borg & Marie Azzopardi-Alexander",
                      "year": 1997,
                      "page": "110–114",
                      "publisher": "Routledge",
                      "role": "pronominal inflection paradigm & morphophonology"
                }
          ],
          "etymology_chain": [
                {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "تَاع",
                      "definition": "of, belonging to (analytic genitive exponent)"
                },
                {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "مَتَاع",
                      "definition": "goods, property, belongings, utility"
                }
          ],
          "etymology_notes": "Inherited from Arabic analytic genitive marker تَاع (tā‘), formed through apheresis of initial m- from Classical/Maghrebi Arabic مَتَاع (matā‘, 'goods, property, belonging to'; Aquilina 1973: 53; Brincat 2011: 112). Cognate with Maghrebi Arabic mtā‘ (Tunisian/Moroccan) and Egyptian bitā‘. In Maltese, ta' functions both as an analytic preposition introducing genitive noun phrases and as a base that combines with pronominal clitics to form independent possessive pronouns. The paradigm displays phonologically conditioned imāla: the historical root vowel ā raises to ie before vowel-initial suffixes (1sg tiegħi, 2sg tiegħek, 3sg.m tiegħu), but remains a before consonant-initial suffixes (3sg.f tagħha, 1pl tagħna, 2pl tagħkom, 3pl tagħhom; Borg & Azzopardi-Alexander 1997: 110).",
          "definitions": [
                {
                      "text_en": "of, belonging to; used as a genitive and possessive marker linking a possessed noun to its possessor or owner",
                      "text_mt": "Prepożizzjoni ewlenija u partikella tal-ġenittiv użata biex tindika pussess, sjieda, jew rabta bejn żewġ ismijiet (eż. il-ktieb ta' Pawlu, il-belt ta' Valletta).",
                      "register": "standard",
                      "nuance": "genitive / possessive marker"
                },
                {
                      "text_en": "used with pronominal suffix clitics as an inflected possessive pronoun base expressing 'mine', 'yours', 'his', 'hers', 'ours', 'theirs'",
                      "text_mt": "Għamla bażika li tintuża bi pronomi mehmuża (milħuqa) biex tifforma pronomi possessivi indipendenti: tiegħi, tiegħek, tiegħu, tagħha, tagħna, tagħkom, tagħhom.",
                      "register": "standard",
                      "nuance": "pronominal possessive base"
                },
                {
                      "text_en": "indicating material, substance, composition, origin, type, or occupation (e.g. ċurkett tad-deheb, għalliem tal-Malti, raġel ta' kelma)",
                      "text_mt": "Tindika materjal, għamla, oriġini, professjoni jew kwalità ta' persuna jew ħaġa (eż. kaxxa tal-injam, tabib tat-tfal, bniedem ta' rispett).",
                      "register": "standard",
                      "nuance": "composition / qualitative reference"
                }
          ],
          "usage_examples": [
                {
                      "mt": "Il-karozza ta' Marija qiegħda pparkjata quddiem il-knisja.",
                      "en": "Marija's car is parked in front of the church."
                },
                {
                      "mt": "Dan il-ktieb huwa tiegħi, u dak ta' fuq il-mejda huwa tiegħek.",
                      "en": "This book is mine, and that one on the table is yours."
                },
                {
                      "mt": "Din id-dar sabiħa hija tagħhom u dik l-oħra hija tagħna.",
                      "en": "This beautiful house is theirs and that other one is ours."
                },
                {
                      "mt": "Huwa magħruf bħala raġel ta' kelma u ta' prinċipju kbir.",
                      "en": "He is known as a man of his word and of great principle."
                },
                {
                      "mt": "Xtrajt ċurkett fin tad-deheb għall-anniversarju tagħna.",
                      "en": "I bought a fine gold ring for our anniversary."
                }
          ],
          "related_entries": [],
          "alternative_forms": [
                "prep-tal"
          ],
          "phonetics": [
                {
                      "dialect": "Standard",
                      "ipa": "/tɐ/",
                      "notes": "Proclitic before nouns; /tɐʔ/ in citation or pause"
                }
          ],
