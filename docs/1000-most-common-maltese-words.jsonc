      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "ذَو / هَدُون",
                      "definition": "these (Maghrebi Arabic plural hadun / ḏaw + -n)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "أُولَاءِ / هٰؤُلَاءِ",
                      "definition": "these (common plural Classical Arabic demonstrative)"
              }
      ],
      "etymology_notes": "Inherited from dialectal Maghrebi Arabic plural demonstratives (cp. Tripoli hadun, Morocco hadun, Tunis hadhuna; Aquilina 1973: 16), rooted in Arabic ذَو (ḏaw) / هٰذُون (hādūn). Modern linguistic consensus identifies this plural nasal ending (-ūn / -un) as the analogical source that spread to singular dan and din. The bare proclitic survives in daw, while the Classical deictic prefix hā- survives in oratorical hedawn.",
      "definitions": [
        {
          "text_en": "these; used as a determiner to identify specific plural people, objects, or entities nearby in space, present in time, or previously mentioned",
          "text_mt": "Determinant dimostrattiv plural użat ma' nom plural definit biex jindika persuni, oġġetti jew entitajiet fil-qrib fl-ispazju, preżenti fil-ħin, jew li għadhom kif issemmew.",
          "register": "standard",
          "nuance": "determiner (attributive)"
        },
        {
          "text_en": "used as a pronoun to refer to specific people, things, facts, or situations in the plural close at hand, currently experienced, or just stated",
          "text_mt": "Pronom dimostrattiv plural użat bħala suġġett jew oġġett biex jirreferi għal bosta persuni, affarijiet, ġrajjiet jew sitwazzjonijiet fil-qrib jew li għadhom kif ġew ippreżentati.",
          "register": "standard",
          "nuance": "pronoun (substantive)"
        },
        {
          "text_en": "indicating the current era, recent times, or days currently unfolding",
          "text_mt": "Jindika ż-żmien preżenti, l-epoka kurrenti jew perjodu kontinwu fiż-żmien (eż. dawn il-jiem, dawn l-aħħar snin, dawż-żminijiet).",
          "register": "standard",
          "nuance": "temporal reference"
        }
      ],
      "usage_examples": [
        {
          "mt": "Dawn l-istudenti ħadmu bla heda matul is-sena skolastika kollha.",
          "en": "These students worked tirelessly throughout the whole school year."
        },
        {
          "mt": "Dawn huma r-riżultati ewlenin tal-istudju xjentifiku li wettaqna.",
          "en": "These are the main results of the scientific study we conducted."
        },
        {
          "mt": "It-temp kien pjuttost xemxi u sabiħ matul dawn il-jiem.",
          "en": "The weather was rather sunny and pleasant over these past few days."
        }
