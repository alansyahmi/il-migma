      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "ذَو",
                      "definition": "these (plural bare proclitic base)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "أُولَاءِ",
                      "definition": "these (plural demonstrative root)"
              }
      ],
      "etymology_notes": "Direct continuation of the bare plural demonstrative base without suffixed -n or prefix hā- (Aquilina 1973: 16). Used as a proclitic attributive before plural nouns (dawl-aħwa, dawl-affarijiet).",
      "definitions": [
        {
          "text_en": "these; proclitic and shortened attributive form of dawn, prefixed before plural definite nouns and adjectives (as in dawl-aħwa, dawl-affarijiet)",
          "text_mt": "Għamla mqassra u proklitika tad-determinant dimostrattiv plural 'dawn', użata quddiem l-artiklu ma' nom plural (eż. dawl-affarijiet, dawl-aħwa).",
          "register": "standard",
          "nuance": "proclitic determiner (attributive)"
        },
        {
          "text_en": "used in plural temporal and situational expressions indicating the present epoch or ongoing days (e.g. dawż-żminijiet 'these times')",
          "text_mt": "Użat f'espressjonijiet temporali plurali li jindikaw l-epoka kurrenti jew il-jiem preżenti (eż. dawż-żminijiet).",
          "register": "standard",
          "nuance": "temporal reference"
        }
      ],
      "usage_examples": [
        {
          "mt": "Dawl-aħwa dejjem kienu ta' għajnuna kbira għall-komunità.",
          "en": "These brothers were always of great help to the community."
        },
        {
          "mt": "F'dawż-żminijiet rari ssib min jieħu ħsieb l-ambjent kif suppost.",
          "en": "In these times you rarely find anyone who looks after the environment properly."
        }
      ],
      "related_entries": [
        "art-dawn",
        "art-da",
        "art-di"
      ],
      "alternative_forms": [
        "art-dawn",
        "art-hedawn",
        "art-hedaw"
      ],
      "phonetics": [
        {
          "dialect": "Standard",
          "ipa": "/dɔw/",
          "notes": "Proclitic, unstressed before definite article"
        }
      ],
