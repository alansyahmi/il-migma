      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "هٰذِي",
                      "definition": "this (feminine singular dialectal demonstrative with analogical -n)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "هٰذِهِ",
                      "definition": "this (feminine singular Classical Arabic demonstrative)"
              }
      ],
      "etymology_notes": "Derives from Classical/MSA feminine demonstrative هٰذِهِ (hāḏihī) / هٰذِي (hāḏī) with prefixed deictic particle هَا (hā-) and analogical -n, raised via Maltese imāla (hā- > he-). Confined to priests' sermons and sacred oratory for oratorical effect (Aquilina 1973: 16).",
      "definitions": [
        {
          "text_en": "this; archaic and oratorical feminine variant of din, confined chiefly to priests' sermons and sacred rhetoric for oratorical effect",
          "text_mt": "Varjant oratorju u arkajku femminil ta' 'din', limitat prinċipalment għall-priedki tal-qassisin u d-diskors reliġjuż għal effett retoriku.",
          "register": "archaic (formal)",
          "nuance": "oratorical (ecclesiastical) demonstrative"
        },
        {
          "text_en": "used as an emphatic feminine demonstrative pronoun to introduce a sacred virtue, grace, or teaching",
          "text_mt": "Użat bħala pronom dimostrattiv enfatiku femminil biex jippreżenta virtù, grazzja jew tagħlima sagra.",
          "register": "archaic (formal)",
          "nuance": "pronoun (substantive)"
        }
      ],
      "usage_examples": [
        {
          "mt": "Hedin hija l-grazzja li Alla ssawwab fuq il-poplu tiegħu.",
          "en": "This is the grace that God poured upon his people."
        },
        {
          "mt": "Hedin is-siegħa li fiha rridu niftħu qalbna għall-maħfra.",
          "en": "This is the hour in which we must open our hearts to forgiveness."
        }
      ],
      "related_entries": [
        "art-din",
        "art-hedan",
        "art-hedi",
        "art-hedawn"
      ],
      "alternative_forms": [
        "art-din",
        "art-hedi"
      ],
      "phonetics": [
        {
          "dialect": "Standard",
          "ipa": "/ˈɛː.dɪn/",
          "notes": "Oratorical (liturgical) register"
        }
      ],
