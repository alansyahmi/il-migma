              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "هٰذَا",
                      "definition": "this (masculine singular demonstrative)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "هَا + ذَا",
                      "definition": "compound of deictic particle hā- + base ḏā"
              }
      ],
      "etymology_notes": "Apocopated oratorical variant directly continuing Classical/MSA هٰذَا (hāḏā) without suffixed -n (hā- + ḏā > he- + da via imāla). Confined to sacred preaching and religious rhetoric for oratorical effect (Aquilina 1973: 16).",
      "definitions": [
        {
          "text_en": "this; shortened oratorical variant of hedan, confined to religious oratory, liturgical sermons, and pulpit eloquence for rhetorical effect",
          "text_mt": "Għamla mqassra ta' 'hedan', użata fil-priedki tal-qassisin u l-oratorija reliġjuża għal effett retoriku.",
          "register": "archaic (formal)",
          "nuance": "oratorical (ecclesiastical) demonstrative"
        }
      ],
      "usage_examples": [
        {
          "mt": "Heda hu l-għemil li bih nuru s-spirtu Nisrani veru.",
          "en": "This is the deed whereby we display the true Christian spirit."
        }
      ],
      "related_entries": [
