      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "ذِي",
                      "definition": "this (feminine singular bare demonstrative base)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "ذِهِ / هٰذِهِ",
                      "definition": "this (feminine singular Classical Arabic demonstrative)"
              }
      ],
      "etymology_notes": "Direct continuation of the bare Arabic feminine demonstrative base ذِي (ḏī), preserving the original pre-analogical stem without suffixed -n or prefix hā- (Aquilina 1973: 16). Used as a proclitic attributive before feminine definite nouns (dil-mara, dil-ġimgħa).",
      "definitions": [
        {
          "text_en": "this; proclitic and shortened attributive form of din, prefixed before feminine definite nouns or adjectives (as in dil-mara, dil-ġimgħa)",
          "text_mt": "Għamla mqassra u proklitika tad-determinant dimostrattiv femminil 'din', użata quddiem l-artiklu ma' nom femminili (eż. dil-mara, dil-ġimgħa).",
          "register": "standard",
          "nuance": "proclitic determiner (attributive)"
        },
        {
          "text_en": "used in temporal and situational expressions referring to the current feminine period or occasion (e.g. dil-ġimgħa 'this week', did-darba 'this time')",
          "text_mt": "Użat f'espressjonijiet temporali u sitwazzjonali ma' nom femminili (eż. dil-ġimgħa, did-darba).",
          "register": "standard",
          "nuance": "temporal reference"
        }
      ],
      "usage_examples": [
        {
          "mt": "Dil-ġimgħa għandna diversi proġetti x'inlestu fuq ix-xogħol.",
          "en": "This week we have several projects to finish at work."
        },
        {
          "mt": "Did-darba rridu noqogħdu attenti biex ma nirripetux l-istess żball.",
          "en": "This time we must be careful not to repeat the same mistake."
        }
      ],
      "related_entries": [
        "art-din",
        "art-da",
        "art-daw"
      ],
      "alternative_forms": [
        "art-din",
        "art-hedin",
        "art-hedi"
      ],
      "phonetics": [
        {
          "dialect": "Standard",
          "ipa": "/dɪ/",
          "notes": "Proclitic, unstressed before definite article"
        }
      ],
