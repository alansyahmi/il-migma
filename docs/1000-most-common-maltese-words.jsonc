                  "citation": "Borg, A. (1978). Historical Aspects of Maltese Phonology, pp. 68–74.",
                  "title": "Historical Aspects of Maltese Phonology",
                  "author": "Alexander Borg",
                  "year": 1978,
                  "page": "68–74",
                  "publisher": "Hebrew University of Jerusalem",
                  "role": "morphophonology & analogical leveling"
            }
      ],
      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "هٰذُون",
                      "definition": "these (plural demonstrative with nasal suffix -ūn)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "هٰؤُلَاءِ",
                      "definition": "these (common plural Classical Arabic demonstrative)"
              }
      ],
      "etymology_notes": "Derives from dialectal Arabic plural demonstrative with deictic prefix هَا (hā-), cognate with Maghrebi hadun / hadhuna and Classical/dialectal hādūn (هٰذُون). Preserved with imāla (hā- > he-) in Maltese pulpit oratory ('confined to priests' sermons for oratorical effect', Aquilina 1973: 16).",
      "definitions": [
        {
          "text_en": "these; archaic and oratorical plural variant of dawn, confined chiefly to priests' sermons and pulpit eloquence for oratorical effect",
          "text_mt": "Varjant oratorju u arkajku plural ta' 'dawn', limitat prinċipalment għall-priedki tal-kleru u d-diskors reliġjuż għal effett retoriku.",
          "register": "archaic (formal)",
          "nuance": "oratorical (ecclesiastical) demonstrative"
        },
        {
          "text_en": "used as an emphatic plural demonstrative pronoun to introduce solemn commandments, sacred words, or witnesses",
          "text_mt": "Użat bħala pronom dimostrattiv enfatiku plural biex jippreżenta kmandamenti, kliem qaddis jew xhieda solenni.",
          "register": "archaic (formal)",
          "nuance": "pronoun (substantive)"
        }
      ],
      "usage_examples": [
        {
          "mt": "Hedawn huma l-kliem qaddisa li ħallielna l-fundatur f'dan il-ktieb.",
          "en": "These are the holy words that the founder left us in this book."
        },
        {
          "mt": "Hedawn in-nies tajba huma l-mudell ħaj tal-komunità tagħna.",
          "en": "These good people are the living model of our community."
        }
      ],
      "related_entries": [
        "art-dawn",
        "art-hedan",
        "art-hedin",
        "art-hedaw"
      ],
      "alternative_forms": [
        "art-dawn",
        "art-hedaw"
      ],
      "phonetics": [
        {
          "dialect": "Standard",
          "ipa": "/ˈɛː.dɔwn/",
          "notes": "Oratorical (liturgical) register"
        }
      ],
