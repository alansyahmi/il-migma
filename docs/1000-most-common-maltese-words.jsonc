      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "هٰذَو",
                      "definition": "these (plural dialectal demonstrative)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "هٰؤُلَاءِ",
                      "definition": "these (common plural Classical Arabic demonstrative)"
              }
      ],
      "etymology_notes": "Apocopated plural variant reflecting the compound of deictic hā- (he-) + plural base daw without suffixed -n. Confined to priests' sermons and liturgical rhetoric for oratorical effect (Aquilina 1973: 16).",
      "definitions": [
        {
          "text_en": "these; shortened oratorical variant of hedawn, confined to ecclesiastical oratory and priests' sermons for rhetorical effect",
          "text_mt": "Għamla mqassra ta' 'hedawn', użata fil-priedki reliġjużi għal effett retoriku.",
          "register": "archaic (formal)",
          "nuance": "oratorical (ecclesiastical) demonstrative"
        }
      ],
      "usage_examples": [
        {
          "mt": "Hedaw huma t-tagħlimiet li rridu ngħaddu lil uliedna f'kull żmien.",
          "en": "These are the teachings that we must pass on to our children in every age."
        }
      ],
      "related_entries": [
        "art-dawn",
        "art-hedawn",
        "art-heda",
        "art-hedi"
      ],
      "alternative_forms": [
        "art-dawn",
