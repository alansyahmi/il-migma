      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "ذَا",
                      "definition": "this (masculine singular bare demonstrative base)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "ذَا",
                      "definition": "masculine proximal demonstrative root"
              }
      ],
      "etymology_notes": "Direct continuation of the bare Arabic masculine demonstrative base ذَا (ḏā), preserving the original pre-analogical stem without suffixed -n or prefix hā- (Aquilina 1973: 16). Used as a proclitic attributive before the definite article or in temporal compounds (daż-żmien, dal-lejl).",
      "definitions": [
        {
          "text_en": "this; proclitic and shortened attributive form of dan, prefixed or compounded before masculine nouns, adjectives, or the definite article",
          "text_mt": "Għamla mqassra u proklitika tad-determinant dimostrattiv maskil 'dan', użata quddiem l-artiklu jew f'komposti temporali (eż. daż-żmien, dal-lejl, dar-raġel).",
          "register": "standard",
          "nuance": "proclitic determiner (attributive)"
        },
        {
          "text_en": "used in temporal and adverbial expressions referring to the current time, night, or day (e.g. daż-żmien 'nowadays', dal-lejl 'tonight')",
          "text_mt": "Użat f'espressjonijiet temporali u avverbjali li jirreferu għaż-żmien kurrenti jew għal-lejl preżenti (eż. daż-żmien, dal-lejl).",
          "register": "standard",
          "nuance": "temporal reference"
        }
      ],
      "usage_examples": [
        {
          "mt": "Daż-żmien in-nies qed iqattgħu aktar ħin fuq l-internet milli jaqraw kotba.",
          "en": "Nowadays people are spending more time on the internet than reading books."
        },
        {
          "mt": "Dal-lejl se jagħmel il-kesħa f'ħafna partijiet tal-gżejjer.",
          "en": "Tonight it will be cold across many parts of the islands."
        }
      ],
      "related_entries": [
        "art-dan",
        "art-di",
        "art-daw"
      ],
      "alternative_forms": [
        "art-dan",
        "art-hedan",
        "art-heda"
      ],
      "phonetics": [
        {
          "dialect": "Standard",
          "ipa": "/dɐ/",
          "notes": "Proclitic, unstressed before definite article"
        }
      ],
