                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "هٰذَا",
                      "definition": "this (masculine singular demonstrative with analogical -n)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "هَا + ذَا",
                      "definition": "compound of deictic particle hā- + base ḏā"
              }
      ],
      "etymology_notes": "Directly derives from Classical/MSA هٰذَا (hāḏā), compounding the deictic alerting particle هَا (hā-) + demonstrative base ذَا (ḏā), with analogical -n and regular Maltese imāla (hā- > he-). Aquilina (1973: 16) notes this form survived 'confined to priests' sermons for oratorical effect' because sacred oratory preserved the elevated Classical/MSA compound with the deictic particle.",
      "definitions": [
        {
          "text_en": "this; archaic and oratorical variant of dan, confined chiefly to priests' sermons, traditional preaching, and solemn ecclesiastical discourse for rhetorical effect",
          "text_mt": "Varjant oratorju u arkajku ta' 'dan', limitat l-aktar għall-priedki tal-qassisin u diskorsi solenni tal-knisja għal effett retoriku.",
          "register": "archaic (formal)",
          "nuance": "oratorical (ecclesiastical) demonstrative"
        },
        {
          "text_en": "used as an emphatic demonstrative pronoun to introduce a theological truth, mystery, or solemn pronouncement",
          "text_mt": "Użat bħala pronom dimostrattiv enfatiku biex jippreżenta verità teoloġika, misteru jew stqarrija solenni.",
          "register": "archaic (formal)",
          "nuance": "pronoun (substantive)"
        }
      ],
      "usage_examples": [
        {
          "mt": "Hedan huwa l-misteru kbir tal-fidi li qegħdin niċċelebraw illum.",
          "en": "This is the great mystery of faith that we are celebrating today."
        },
        {
          "mt": "Hedan il-jum imqaddes ifakkarna fl-imħabba infinita ta' Alla.",
          "en": "This holy day reminds us of God's infinite love."
        }
      ],
      "related_entries": [
        "art-dan",
        "art-heda",
        "art-hedin",
        "art-hedawn"
      ],
      "alternative_forms": [
        "art-dan",
        "art-heda"
      ],
      "phonetics": [
        {
          "dialect": "Standard",
          "ipa": "/ˈɛː.dɐn/",
          "notes": "Oratorical (liturgical) register"
        }
      ],
