      "etymology_chain": [
              {
                      "relationship": "Inherited from",
                      "language": "Arabic",
                      "term": "ذِي",
                      "definition": "this (feminine singular demonstrative base with analogical -n)"
              },
              {
                      "relationship": "From",
                      "language": "Classical Arabic",
                      "term": "ذِهِ / هٰذِهِ",
                      "definition": "this (feminine singular Classical Arabic demonstrative)"
              }
      ],
      "etymology_notes": "Inherited from Arabic feminine demonstrative base ذِي (ḏī). Modern comparative linguistics refutes an ancient Semitic substrate for final -n, analyzing it as an internal dialectal analogical extension from plural dawn / hadun to singular di > din, reinforced by the locative hawn ('here'). The bare stem survives in proclitic di, while Classical/MSA feminine هٰذِهِ (hāḏihī) / هٰذِي (hāḏī) survives in oratorical hedin via Maltese imāla.",
      "definitions": [
        {
          "text_en": "this; used as a determiner to identify a specific singular feminine person, object, or entity nearby in space, present in time, or previously mentioned",
          "text_mt": "Determinant dimostrattiv femminil użat ma' nom definit biex jindika persuna, oġġett jew entità fil-qrib fl-ispazju, preżenti fil-ħin, jew li għadha kif issemmiet.",
          "register": "standard",
          "nuance": "determiner (attributive)"
        },
        {
          "text_en": "used as a pronoun to refer to a specific feminine person, thing, fact, or situation close at hand, currently experienced, or just stated",
          "text_mt": "Pronom dimostrattiv użat bħala suġġett jew oġġett biex jirreferi għal persuna, ħaġa, ġrajja jew sitwazzjoni konkreta jew astratta li tinsab fil-qrib jew li għadha kif ġiet ippreżentata.",
          "register": "standard",
          "nuance": "pronoun (substantive)"
        },
        {
          "text_en": "indicating the current, ongoing, or immediately upcoming period or occasion (with feminine temporal nouns)",
          "text_mt": "Jindika l-perjodu ta' żmien jew l-okkażjoni kurrenti jew immedjata ma' nom femminili ta' żmien (eż. din il-ġimgħa, din is-sena, din id-darba).",
          "register": "standard",
          "nuance": "temporal reference"
        }
      ],
      "usage_examples": [
        {
          "mt": "Din il-belt għandha storja rikka u arkitettura mill-isbaħ.",
          "en": "This city has a rich history and magnificent architecture."
        },
        {
          "mt": "Din hija l-aqwa deċiżjoni li stajna nieħdu f'dawn iċ-ċirkostanzi.",
          "en": "This is the best decision we could have made in these circumstances."
        },
        {
          "mt": "Se nlestu r-rapport finali tal-proġett matul din il-ġimgħa.",
          "en": "We will complete the project's final report during this week."
        }
      ],
