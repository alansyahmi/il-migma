          "register": "",
          "nuance": ""
        },
        {
          "text_en": "to act as an intermediate",
          "text_mt": "Azzjoni ta' kif wieħed to act as an intermediate",
          "register": "",
          "nuance": ""
        },
        {
          "text_en": "to be involved [with bejn]",
          "text_mt": "Azzjoni ta' kif wieħed to act as an intermediate",
          "register": "",
          "nuance": ""
        },
