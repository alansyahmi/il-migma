            "key": "ecclesiastical",
            "en": "Ecclesiastical",
            "mt": "Ekkleżjastiku",
            "arabised": "Knisi"
          }
        },
        {
          "text_en": "to prove",
          "text_mt": "Juri b'evidenza ċara u b'argumenti sodi li ħaġa hi vera.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        }
      ],
      "usage_examples": [
        {
          "mt": "Ipprova jiftaħ il-bieb bil-muftieħ l-antik.",
          "en": "He tried to open the door with the old key."
        },
        {
          "mt": "Ippruvajt il-libsa qabel ma xtrajtha.",
          "en": "I tried on the dress before I bought it."
