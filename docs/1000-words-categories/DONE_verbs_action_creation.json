          "pronunciation": "stampa",
          "definition": "print, press, printed picture"
        }
      ],
      "definitions": [
        {
          "text_en": "picture, print, printed image",
          "text_mt": "Xbieha ta' persuna, post jew ħaġa, ippinġuta jew maħruġa fuq karta, ħafna drabi biex titwaħħal jew tinżamm għat-tifkira.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        },
        {
          "text_en": "the press (newspapers and news media)",
          "text_mt": "Il-gazzetti, ir-rivisti u l-mezzi tax-xandir meqjusa flimkien, kif ukoll il-ġurnalisti li jaħdmu fihom.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        },
        {
          "text_en": "printing, printing press",
          "text_mt": "Is-sengħa jew il-magna li biha jinħarġu kotba, gazzetti u karti oħra b'ittri u xbihat bil-linka.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        }
      ],
      "usage_examples": [
        {
          "mt": "Fil-kamra tagħha kellha stampa tal-Madonna mdendla mal-ħajt.",
          "en": "In her room she had a picture of Our Lady hanging on the wall."
        },
        {
          "mt": "L-istampa lokali rrappurtat l-aħbar fl-ewwel paġna.",
          "en": "The local press reported the news on the front page."
        }
      ],
