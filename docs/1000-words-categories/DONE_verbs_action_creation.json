      "usage_notes": {
        "mt": "Mal-artiklu tieħu i- protetika quddiem il-grupp konsonantiku st-: l-istampa, mhux il-stampa.",
        "en": "With the article it takes a prosthetic i- before the initial cluster st-: l-istampa, not il-stampa."
      },
      "etymology_chain": [
        {
          "relationship": "Borrowed from",
          "language": "Italian",
