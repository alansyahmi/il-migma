          "term": "عَاشَ",
          "pronunciation": "għâxa",
          "definition": "to live, subsist"
        }
      ],
      "definitions": [
        {
          "text_en": "to live, be alive, reside",
          "text_mt": "Ikollu l-ħajja u jibqa’ ħaj, jew jgħaddi ħajtu f’post partikolari.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        },
        {
          "text_en": "to subsist, earn a living",
          "text_mt": "Imantni lilu nnifsu u jibqa’ jgħaddi ħajtu permezz ta’ xogħol jew riżorsi.",
          "register": {
            "key": "figurative",
            "en": "Figurative",
            "mt": "Figurattiv",
            "arabised": "Suri"
          }
        }
      ],
      "usage_examples": [
        {
          "mt": "Nannuh għex ħajja twila u kwieta fir-raħal twelidu.",
          "en": "His grandfather lived a long and quiet life in his native village."
        },
        {
          "mt": "Il-familja tagħhom ilha tgħix f’Għawdex għal ħafna snin.",
          "en": "Their family has been living in Gozo for many years."
        }
      ],
