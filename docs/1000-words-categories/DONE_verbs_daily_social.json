          "text_en": "to die, pass away, perish",
          "text_mt": "Jitlef ħajtu u jieqaf jgħix, bit-tmiem tal-eżistenza fiżika.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        },
        {
          "text_en": "to die down, fade away, cease",
          "text_mt": "Jintefa, jonqos bil-mod jew jisparixxi għalkollox, bħan-nar jew bħal drawwa antika.",
          "register": {
            "key": "figurative",
            "en": "Figurative",
            "mt": "Figurattiv",
            "arabised": "Suri"
          }
        }
      ],
      "usage_examples": [
