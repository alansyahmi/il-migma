      "definitions": [
        {
          "text_en": "to help, assist, aid",
          "text_mt": "Jagħti l-appoġġ, is-sostenn jew is-sehem tiegħu lil ħaddieħor biex iwettaq ħaġa jew jegħleb diffikultà.",
          "register": {
