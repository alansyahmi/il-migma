      "definitions": [
        {
          "text_en": "to eat, consume food",
          "text_mt": "Idaħħal l-ikel f’ħalqu, jomogħdu u jibilgħu biex jieħu n-nutriment.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        },
        {
          "text_en": "to erode, wear away, corrode",
          "text_mt": "Iħassar jew inaqqar wiċċ iebes bil-mod il-mod, bħas-sadid jew l-ilma baħar.",
          "register": {
            "key": "figurative",
            "en": "Figurative",
            "mt": "Figurattiv",
            "arabised": "Suri"
          }
        }
      ],
      "usage_examples": [
        {
          "mt": "Kiel platt għaġin sħun wara ġurnata twila ta’ xogħol.",
          "en": "He ate a plate of hot pasta after a long day of work."
        },
        {
          "mt": "Filgħaxija l-familja kollha tiltaqa’ biex tiekol flimkien.",
          "en": "In the evening the whole family gathers to eat together."
        }
      ],
