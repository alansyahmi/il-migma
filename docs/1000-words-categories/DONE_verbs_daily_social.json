            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        }
      ],
      "usage_examples": [
        {
          "mt": "Għen lil oħtu ż-żgħira biex tlesti l-kompitu tal-iskola.",
          "en": "He helped his younger sister finish her schoolwork."
        },
        {
          "mt": "Il-ġirien jgħinu lil xulxin kull meta jinqala’ xi bżonn.",
          "en": "The neighbours help each other whenever a need arises."
        }
      ],
