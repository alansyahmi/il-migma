      "definitions": [
        {
          "text_en": "to lose, misplace, forfeit",
          "text_mt": "Jibqa’ mingħajr ħaġa li kellu qabel, billi titwarrab minn idejh jew ma jsibhiex aktar.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        },
        {
          "text_en": "to lose (a match, contest, or opportunity)",
          "text_mt": "Joħroġ tellief f’logħba, f’kompetizzjoni jew f’kawża, jew jaħli opportunità.",
          "register": {
            "key": "standard",
            "en": "Standard",
            "mt": "Standard",
            "arabised": "Miqjiesi"
          }
        }
      ],
      "usage_examples": [
        {
          "mt": "Tilef iċ-ċwievet tad-dar waqt li kien miexi lura mix-xogħol.",
          "en": "He lost the house keys while walking back from work."
        },
        {
          "mt": "It-tim tagħhom jitlef rarament meta jilgħab fil-grawnd tiegħu.",
          "en": "Their team rarely loses when it plays at its home ground."
        }
      ],
